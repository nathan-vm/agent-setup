#!/usr/bin/env bash
# agent-setup — hub to bootstrap a Claude Code dev setup: shared skills/commands,
# MCP servers, optional third-party plugins (rtk, ponytail, caveman, superpowers,
# anthropic official skills) and the local observability stack. Everything is
# opt-in, asked one item at a time, and each item can go global (~/.claude, all
# projects) or project (this repo only).
#
# Usage:
#   agent-setup                     # interactive wizard (default)
#   agent-setup wizard              # same, explicit
#   agent-setup install [TARGET]    # non-interactive: drop the bundle into TARGET
#   agent-setup install --force [TARGET]
#   agent-setup --list              # show what the bundle contains
#   agent-setup --help
#
# Bundle merge behaviour (used by both the wizard's "skills" step and `install`):
#   .claude/skills/*         copied per-skill; existing dirs skipped unless --force
#   .claude/commands/*       copied per-tree;  existing files skipped unless --force
#   .claude/agents/*         copied per-file;  existing files skipped unless --force
#   .claude/hooks/*          copied per-file;  existing files skipped unless --force
#   .claude/settings.local.template.json -> target's settings.local.json
#                            permissions.allow + hooks merged (deduped)

set -euo pipefail

# --- resolve bundle location -------------------------------------------------
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd "$BIN_DIR/.." && pwd)"
BUNDLE="$REPO_ROOT/bundle"

usage() {
  sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
}

require_jq() {
  command -v jq >/dev/null || { echo "agent-setup: jq is required (brew install jq)" >&2; exit 1; }
}

# --- bundle: skills/commands/settings/mcp ------------------------------------
# install_bundle TARGET FORCE(0|1)
install_bundle() {
  local target="$1" force="$2"
  [ -d "$BUNDLE/.claude" ] || { echo "agent-setup: bundle not found at $BUNDLE" >&2; exit 1; }
  require_jq

  target="$(mkdir -p "$target" && cd "$target" && pwd)"
  echo "agent-setup -> $target"
  mkdir -p "$target/.claude"

  local copied=0 skipped=0

  mkdir -p "$target/.claude/skills"
  for src in "$BUNDLE"/.claude/skills/*/; do
    local name; name="$(basename "$src")"
    local dst="$target/.claude/skills/$name"
    if [ -e "$dst" ] && [ "$force" -eq 0 ]; then
      echo "  skill  $name  (exists, skip)"; skipped=$((skipped+1)); continue
    fi
    rm -rf "$dst"; cp -R "$src" "$dst"
    echo "  skill  $name  (installed)"; copied=$((copied+1))
  done

  while IFS= read -r rel; do
    local src="$BUNDLE/.claude/$rel"
    local dst="$target/.claude/$rel"
    mkdir -p "$(dirname "$dst")"
    if [ -e "$dst" ] && [ "$force" -eq 0 ]; then
      echo "  cmd    $rel  (exists, skip)"; skipped=$((skipped+1)); continue
    fi
    cp "$src" "$dst"
    echo "  cmd    $rel  (installed)"; copied=$((copied+1))
  done < <( cd "$BUNDLE/.claude" && find commands -type f )

  # Agent definitions and the SessionStart hook: same per-file copy as commands.
  while IFS= read -r rel; do
    local src="$BUNDLE/.claude/$rel"
    local dst="$target/.claude/$rel"
    mkdir -p "$(dirname "$dst")"
    if [ -e "$dst" ] && [ "$force" -eq 0 ]; then
      echo "  agent  $rel  (exists, skip)"; skipped=$((skipped+1)); continue
    fi
    cp "$src" "$dst"
    [ "${rel%.sh}" != "$rel" ] && chmod +x "$dst"
    echo "  agent  $rel  (installed)"; copied=$((copied+1))
  done < <( cd "$BUNDLE/.claude" && find agents hooks -type f 2>/dev/null )

  # The bundle ships this as *.template.json: a file literally named
  # settings.local.json is caught by the common global gitignore rule
  # (**/.claude/settings.local.json), so it would never be versioned — and a fresh
  # clone would silently install no permissions and no hooks at all.
  local bset="$BUNDLE/.claude/settings.local.template.json"
  local tset="$target/.claude/settings.local.json"
  if [ -f "$bset" ]; then
    if [ -f "$tset" ]; then
      local tmp; tmp="$(mktemp)"
      jq -s '
        .[0] as $cur | .[1] as $add |
        $cur
        | .permissions.allow = (((($cur.permissions.allow) // []) + (($add.permissions.allow) // [])) | unique)
        | .hooks = (($cur.hooks) // {}) * (($add.hooks) // {})
      ' "$tset" "$bset" > "$tmp" && mv "$tmp" "$tset"
      echo "  cfg    .claude/settings.local.json  (merged)"
    else
      cp "$bset" "$tset"
      echo "  cfg    .claude/settings.local.json  (installed)"
    fi
    copied=$((copied+1))
  fi

  echo
  echo "done: $copied written, $skipped skipped.  Re-run with --force to overwrite skipped items."
}

cmd_list() {
  [ -d "$BUNDLE/.claude" ] || { echo "agent-setup: bundle not found at $BUNDLE" >&2; exit 1; }
  echo "bundle: $BUNDLE"
  echo
  echo "skills:";   ls -1 "$BUNDLE/.claude/skills" | sed 's/^/  /'
  echo "commands:"; ( cd "$BUNDLE/.claude" && find commands -type f | sed 's/^/  /' )
  echo "configs:"
  echo "  .claude/settings.local.json (permissions.allow)"
  echo
  echo "wizard also offers: MCP servers (context7, github, playwright,"
  echo "sequential-thinking), rtk, ponytail, caveman, superpowers, anthropic"
  echo "official skills (example-skills, document-skills), and the observability stack."
}

cmd_install() {
  local force=0 target=""
  for arg in "$@"; do
    case "$arg" in
      --force) force=1 ;;
      -*) echo "agent-setup install: unknown flag: $arg" >&2; exit 2 ;;
      *)  target="$arg" ;;
    esac
  done
  install_bundle "${target:-$PWD}" "$force"
}

# --- wizard helpers -----------------------------------------------------------
# ask_yn "prompt" default(Y|N) -> 0 (yes) / 1 (no)
ask_yn() {
  local prompt="$1" default="${2:-N}" hint ans
  hint="y/N"; [ "$default" = "Y" ] && hint="Y/n"
  read -r -p "$prompt [$hint] " ans || ans=""
  ans="${ans:-$default}"
  [[ "$ans" =~ ^[Yy] ]]
}

# ask_scope "label" -> echoes "global" or "projeto"
ask_scope() {
  local label="$1" ans
  read -r -p "    -> $label: install (g)lobal [all projects] or (p)roject [$PWD]? [p] " ans >&2 || ans=""
  ans="${ans:-p}"
  if [[ "$ans" =~ ^[Gg] ]]; then echo global; else echo projeto; fi
}

section() { echo; echo "── $1 ──────────────────────────────────────"; }

wizard_bundle() {
  section "Skills & commands (OpenSpec, commit-split)"
  if ask_yn "Install the shared skills/commands bundle?" Y; then
    local scope; scope="$(ask_scope "skills/commands")"
    local target=$PWD
    [ "$scope" = "global" ] && target="$HOME"
    install_bundle "$target" 0
  fi
}

wizard_mcp() {
  section "MCP servers"
  echo "  Pick which ones to enable. Each can go global (all projects, 'user' scope)"
  echo "  or project-only ('project' scope, writes .mcp.json in this repo)."

  local name cmd scope claude_scope

  if ask_yn "  context7 (always-current library docs)?" Y; then
    scope="$(ask_scope "context7")"; claude_scope=user; [ "$scope" = "projeto" ] && claude_scope=project
    claude mcp add context7 --scope "$claude_scope" -- npx -y @upstash/context7-mcp || true
  fi

  if ask_yn "  GitHub (PRs, issues, code search via API oficial)?" Y; then
    scope="$(ask_scope "github")"; claude_scope=user; [ "$scope" = "projeto" ] && claude_scope=project
    claude mcp add --transport http github https://api.githubcopilot.com/mcp/ --scope "$claude_scope" || true
    echo "    (na primeira vez: rode 'claude mcp login github' pra autenticar)"
  fi

  if ask_yn "  Playwright (browser automation/inspection)?" Y; then
    scope="$(ask_scope "playwright")"; claude_scope=user; [ "$scope" = "projeto" ] && claude_scope=project
    claude mcp add playwright --scope "$claude_scope" -- npx -y @playwright/mcp@latest || true
  fi

  if ask_yn "  Sequential Thinking (forces step-by-step reasoning on complex tasks)?" N; then
    scope="$(ask_scope "sequential-thinking")"; claude_scope=user; [ "$scope" = "projeto" ] && claude_scope=project
    claude mcp add sequential-thinking --scope "$claude_scope" -- npx -y @modelcontextprotocol/server-sequential-thinking || true
  fi
}

wizard_rtk() {
  section "rtk (Rust Token Killer — compresses bash output by up to 90%)"
  if ask_yn "  Install rtk?" N; then
    if ! command -v rtk >/dev/null; then
      curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh
      echo '  (add ~/.local/bin to PATH if it is not there yet)'
    else
      echo "  rtk já instalado ($(command -v rtk))"
    fi
    local scope; scope="$(ask_scope "hook do rtk")"
    if [ "$scope" = "global" ]; then
      rtk init -g
    else
      ( cd "$PWD" && rtk init )
    fi
  fi
}

wizard_plugin() {
  # wizard_plugin "label" "marketplace-repo (empty = already-registered marketplace)" "plugin@marketplace"
  local label="$1" repo="$2" plugin="$3" scope claude_scope
  section "$label"
  if ask_yn "  Install $label?" N; then
    [ -n "$repo" ] && { claude plugin marketplace add "$repo" || true; }
    scope="$(ask_scope "$label")"; claude_scope=user; [ "$scope" = "projeto" ] && claude_scope=project
    claude plugin install "$plugin" --scope "$claude_scope" -y || true
  fi
}

# Discovers Claude Code config directories (the ones with "projects/" inside) and
# the account of each, read from oauthAccount in .claude.json. Echoes "path<TAB>email".
discover_claude_dirs() {
  local d email
  for d in "$HOME"/.claude "$HOME"/.claude-*; do
    [ -d "$d/projects" ] || continue
    email="$(python3 -c 'import json,sys,pathlib
try:
    c = json.load(open(pathlib.Path(sys.argv[1]) / ".claude.json")).get("oauthAccount") or {}
    print(c.get("emailAddress") or "")
except Exception:
    print("")' "$d" 2>/dev/null)"
    printf '%s\t%s\n' "$d" "${email:-(conta nao identificada)}"
  done
}

# Writes .env (+ docker-compose.override.yml when there is more than one
# directory) and records in account-limits.json the accounts the user does NOT
# want to monitor.
wizard_observability_dirs() {
  local obs="$REPO_ROOT/observability"
  section "Observability — which accounts to monitor"

  local -a dirs=() emails=()
  local d e
  while IFS="$(printf '\t')" read -r d e; do
    dirs+=("$d"); emails+=("$e")
  done < <(discover_claude_dirs)

  if [ "${#dirs[@]}" -eq 0 ]; then
    echo "  No config directory found (~/.claude*/projects)."
    echo "  Falling back to ~/.claude — re-run the wizard after your first session."
    printf 'EXPORTER_STREAM=claude-code-exporter-1\nCLAUDE_DIR=${HOME}/.claude\n' > "$obs/.env"
    return
  fi

  echo "  Found:"
  local i
  for i in "${!dirs[@]}"; do
    printf '    [%d] %-24s %s\n' "$((i+1))" "$(basename "${dirs[$i]}")" "${emails[$i]}"
  done
  echo

  local -a chosen=()
  if [ "${#dirs[@]}" -eq 1 ]; then
    chosen=(0)
    echo "  Only one directory — using it."
  elif ask_yn "  Monitor all of these accounts?" Y; then
    for i in "${!dirs[@]}"; do chosen+=("$i"); done
  else
    for i in "${!dirs[@]}"; do
      ask_yn "    Monitor ${emails[$i]} ($(basename "${dirs[$i]}"))?" Y && chosen+=("$i")
    done
  fi

  if [ "${#chosen[@]}" -eq 0 ]; then
    echo "  No account selected; nothing to configure."
    return
  fi

  # Preserve the current EXPORTER_STREAM: changing it by accident makes the stack
  # reimport everything into a new stream and orphan the old one.
  local stream=""
  [ -f "$obs/.env" ] && stream="$(sed -n 's/^EXPORTER_STREAM=//p' "$obs/.env" | head -1)"
  [ -n "$stream" ] || stream="claude-code-exporter-1"

  {
    echo "# Generated by agent-setup. Not versioned (paths on this machine)."
    echo "# Template: .env.example"
    echo "EXPORTER_STREAM=$stream"
    echo "CLAUDE_DIR=${dirs[${chosen[0]}]}"
  } > "$obs/.env"

  if [ "${#chosen[@]}" -gt 1 ]; then
    {
      echo "# Generated by agent-setup. Not versioned."
      echo "# The first directory comes from CLAUDE_DIR in .env; the rest go here."
      echo "services:"
      echo "  transcript-exporter:"
      echo "    volumes:"
      local n=1 idx
      for idx in "${chosen[@]:1}"; do
        echo "      - ${dirs[$idx]}/projects:/transcripts/d$n:ro"
        n=$((n+1))
      done
    } > "$obs/docker-compose.override.yml"
    echo "  ${#chosen[@]} directories configured (.env + docker-compose.override.yml)"
  else
    rm -f "$obs/docker-compose.override.yml"
    echo "  1 directory configured (.env)"
  fi

  # A discovered account that was left out goes on the ignore list: without it the
  # generator creates an empty dashboard for it as soon as the email shows up in
  # Prometheus (and the email only leaves when retention expires).
  local -a out_of=()
  local inside idx
  for i in "${!dirs[@]}"; do
    inside=0
    for idx in "${chosen[@]}"; do [ "$idx" = "$i" ] && inside=1; done
    if [ "$inside" = 0 ] && [ "${emails[$i]}" != "(account not identified)" ]; then
      out_of+=("${emails[$i]}")
    fi
  done
  local limits_file="$obs/grafana/account-limits.json"
  [ -f "$limits_file" ] || cp "$obs/grafana/account-limits.example.json" "$limits_file"
  if [ "${#out_of[@]}" -gt 0 ]; then
    if command -v jq >/dev/null; then
      local tmp; tmp="$(mktemp)"
      jq --argjson ig "$(printf '%s\n' "${out_of[@]}" | jq -R . | jq -s .)" \
        '.ignore = $ig | .accounts = {}' "$limits_file" > "$tmp" && mv "$tmp" "$limits_file"
      echo "  not monitored: ${out_of[*]}"
    else
      echo "  warning: jq missing — add this by hand to grafana/account-limits.json:"
      echo "           \"ignore\": [${out_of[*]}]"
    fi
  fi
}

wizard_observability() {
  section "Observability (OTel Collector + Prometheus + Loki + Grafana, local)"
  if ask_yn "  Bring the stack up and enable Claude Code telemetry in this shell?" N; then
    wizard_observability_dirs
    ( cd "$REPO_ROOT/observability" && docker compose up -d )
    echo "  Grafana: http://localhost:47300  (dashboard 'Claude Code — Uso & Custo')"

    local marker="# agents-setup: claude telemetry"
    local shell_name; shell_name="$(basename "${SHELL:-bash}")"
    local rc="$HOME/.bashrc"
    [ "$shell_name" = "zsh" ] && rc="$HOME/.zshrc"
    if [ "$shell_name" = "fish" ]; then
      local fish_cfg="$HOME/.config/fish/config.fish"
      if ! grep -qF "$marker" "$fish_cfg" 2>/dev/null; then
        { echo "$marker"; cat "$REPO_ROOT/observability/claude-telemetry.fish"; } >> "$fish_cfg"
        echo "  telemetry env vars adicionadas a $fish_cfg"
      else
        echo "  telemetry env vars já presentes em $fish_cfg"
      fi
    else
      if ! grep -qF "$marker" "$rc" 2>/dev/null; then
        # Read from the file instead of repeating the values here: duplicating
        # them once left the intervals out of sync, with the wizard writing
        # 10s/5s while the file was already at 60s/30s.
        { echo "$marker"; cat "$REPO_ROOT/observability/claude-telemetry.sh"; } >> "$rc"
        echo "  telemetry env vars adicionadas a $rc (abra um terminal novo, ou 'source $rc')"
      else
        echo "  telemetry env vars já presentes em $rc"
      fi
    fi
  fi
}

cmd_wizard() {
  echo "agent-setup wizard — monte seu ambiente Claude Code"
  echo "Every item is optional; for each one you pick, you choose global or per-project."
  echo

  wizard_bundle
  wizard_mcp
  wizard_rtk
  wizard_plugin "ponytail (avoids over-engineering, prefers stdlib/native solutions)" \
    "DietrichGebert/ponytail" "ponytail@ponytail"
  wizard_plugin "caveman (respostas ultra-comprimidas, corta ~65% dos tokens de output)" \
    "JuliusBrussee/caveman" "caveman@caveman"
  wizard_plugin "Superpowers (metodologia: TDD, systematic-debugging, git-worktrees, brainstorming, code review)" \
    "" "superpowers@claude-plugins-official"
  wizard_plugin "Anthropic official — example-skills (skill-creator, mcp-builder, webapp-testing, frontend-design)" \
    "anthropics/skills" "example-skills@anthropic-agent-skills"
  wizard_plugin "Anthropic official — document-skills (docx, pdf, pptx, xlsx)" \
    "anthropics/skills" "document-skills@anthropic-agent-skills"
  wizard_observability

  echo
  echo "wizard done."
}

# --- entrypoint ---------------------------------------------------------------
case "${1:-}" in
  --list) cmd_list; exit 0 ;;
  -h|--help) usage; exit 0 ;;
  install) shift; cmd_install "$@"; exit 0 ;;
  wizard) cmd_wizard; exit 0 ;;
  --force)
    # back-compat: `agent-setup --force [TARGET]` == old non-interactive default
    shift; cmd_install --force "$@"; exit 0 ;;
  "") cmd_wizard; exit 0 ;;
  -*) echo "agent-setup: unknown flag: $1" >&2; exit 2 ;;
  *)
    # back-compat: `agent-setup TARGET` == old non-interactive default
    cmd_install "$@"; exit 0 ;;
esac
