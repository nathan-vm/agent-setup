# Modelo de configuração do stack. Copie para .env e ajuste:
#
#   cp .env.example .env
#
# Ou deixe o wizard fazer isso por você, que também descobre as pastas de config
# do Claude Code e pergunta quais contas monitorar:
#
#   bin/agent-setup
#
# O .env real não é versionado: ele aponta para caminhos desta máquina.

# Stream onde o transcript-exporter escreve e de onde os painéis leem.
# É VERSIONADO NO NOME, de propósito: o Loki não sabe substituir dados derivados,
# então reimportar = escrever num nome novo. Para reconstruir do zero:
#   1. suba o número aqui
#   2. docker compose down
#   3. docker volume rm agents-observability_exporter-state
#   4. docker compose up -d
EXPORTER_STREAM=claude-code-exporter-1

# Pasta de config do Claude Code a varrer (a que contém "projects/").
# O padrão do Claude Code é ~/.claude.
CLAUDE_DIR=${HOME}/.claude

# MAIS DE UMA PASTA? É comum ter contas separadas por contexto — ~/.claude-work e
# ~/.claude-personal, por exemplo. Varrer só uma perde os dados da outra em
# silêncio: os painéis simplesmente mostram uma fração do uso.
#
# Para varrer várias, crie um docker-compose.override.yml (também não versionado)
# montando cada uma numa subpasta de /transcripts, que o exporter varre
# recursivamente:
#
#   services:
#     transcript-exporter:
#       volumes:
#         - ${HOME}/.claude-work/projects:/transcripts/d0:ro
#         - ${HOME}/.claude-personal/projects:/transcripts/d1:ro
#
# O wizard gera esse arquivo sozinho quando você escolhe mais de uma pasta.
