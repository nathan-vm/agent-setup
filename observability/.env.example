# Stack configuration template. Copy it to .env and adjust:
#
#   cp .env.example .env
#
# Or let the wizard do it for you — it also discovers your Claude Code config
# directories and asks which accounts you want to monitor:
#
#   bin/agent-setup
#
# The real .env is not versioned: it points at paths on this machine.

# Stream the transcript-exporter writes to, and the panels read from.
# The NAME is versioned on purpose: Loki cannot replace derived data, so
# reimporting means writing under a new name. To rebuild from scratch:
#   1. bump the number here
#   2. docker compose down
#   3. docker volume rm agents-observability_exporter-state
#   4. docker compose up -d
EXPORTER_STREAM=claude-code-exporter-1

# Smoothing half-life of the consumption-rate panel. Shared by transcript-exporter
# (which computes the curve) and dashboard-generator (which computes its cutlines
# from that same curve) — a mismatch would put the reference line under a
# distribution nobody is looking at. It is also a stream label, so changing it
# simply starts a fresh series instead of mixing two different maths.
# Shorter = twitchier, longer = more sluggish. 20m was calibrated on real data.
RATE_HALFLIFE=20m

# Claude Code config directory to scan (the one containing "projects/").
# Claude Code's default is ~/.claude.
CLAUDE_DIR=${HOME}/.claude

# MORE THAN ONE DIRECTORY? It is common to keep accounts split by context —
# ~/.claude-work and ~/.claude-personal, for instance. Scanning only one loses
# the other's data silently: the panels just show a fraction of your usage.
#
# To scan several, create a docker-compose.override.yml (also not versioned)
# mounting each one as a subfolder of /transcripts, which the exporter scans
# recursively:
#
#   services:
#     transcript-exporter:
#       volumes:
#         - ${HOME}/.claude-work/projects:/transcripts/d1:ro
#         - ${HOME}/.claude-personal/projects:/transcripts/d2:ro
#
# The wizard generates that file for you when you pick more than one directory.
