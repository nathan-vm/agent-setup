{
  "uid": "claude-code",
  "title": "Claude Code",
  "description": "Template. The generator writes one dashboard per account from this file — do not provision it directly.",
  "tags": [
    "claude-code"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5m",
  "graphTooltip": 1,
  "time": {
    "from": "now/w+9h+24h",
    "to": "now"
  },
  "timepicker": {
    "quick_ranges": [
      {
        "display": "Current week (from Mon 9am)",
        "from": "now/w+9h+24h",
        "to": "now"
      },
      {
        "display": "Current day (from 9am)",
        "from": "now/d+9h",
        "to": "now"
      },
      {
        "display": "Last 5 hours",
        "from": "now-5h",
        "to": "now"
      },
      {
        "display": "Last 24 hours",
        "from": "now-24h",
        "to": "now"
      },
      {
        "display": "Last 7 days",
        "from": "now-7d",
        "to": "now"
      },
      {
        "display": "Last 30 days",
        "from": "now-30d",
        "to": "now"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "account",
        "label": "Account",
        "type": "constant",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 2
      },
      {
        "name": "server",
        "label": "MCP server",
        "type": "custom",
        "query": ".*",
        "options": [
          {
            "text": "All",
            "value": ".*",
            "selected": true
          }
        ],
        "current": {
          "text": "All",
          "value": ".*"
        },
        "includeAll": false,
        "multi": false,
        "hide": 0
      },
      {
        "name": "owner",
        "label": "Skill owner",
        "type": "custom",
        "query": ".*",
        "options": [
          {
            "text": "All",
            "value": ".*",
            "selected": true
          }
        ],
        "current": {
          "text": "All",
          "value": ".*"
        },
        "includeAll": false,
        "multi": false,
        "hide": 0
      },
      {
        "name": "limit_tokens_5h",
        "label": "Token reference (5h block)",
        "type": "textbox",
        "query": "1750000",
        "current": {
          "text": "1750000",
          "value": "1750000"
        },
        "hide": 2
      },
      {
        "name": "limit_tokens_week",
        "label": "Token reference (week)",
        "type": "textbox",
        "query": "21500000",
        "current": {
          "text": "21500000",
          "value": "21500000"
        },
        "hide": 2
      },
      {
        "name": "skill",
        "type": "textbox",
        "hide": 2,
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": []
      },
      {
        "name": "source",
        "type": "textbox",
        "hide": 2,
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "OVERVIEW",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 1,
      "type": "gauge",
      "title": "5h block limit — % used",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "(vector(100) < (100 * sum(last_over_time({service_name=\"claude-code-usage\"} | user_email =~ `$account` | unwrap block_tokens [30m]) by (user_email)) / $limit_tokens_5h)) or (100 * sum(last_over_time({service_name=\"claude-code-usage\"} | user_email =~ `$account` | unwrap block_tokens [30m]) by (user_email)) / $limit_tokens_5h)",
          "queryType": "range",
          "hide": false,
          "legendFormat": "used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75,
        "sizing": "auto"
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Weekly limit — % used",
      "datasource": {
