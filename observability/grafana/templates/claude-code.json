            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "(vector(100) < (100 * sum(last_over_time({service_name=\"claude-code-usage\"} | user_email =~ `$account` | unwrap week_tokens [30m]) by (user_email)) / $limit_tokens_week)) or (100 * sum(last_over_time({service_name=\"claude-code-usage\"} | user_email =~ `$account` | unwrap week_tokens [30m]) by (user_email)) / $limit_tokens_week)",
          "queryType": "range",
          "hide": false,
          "legendFormat": "used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
