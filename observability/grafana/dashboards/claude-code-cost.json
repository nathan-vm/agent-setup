          "expr": "sum by (server, tool) (label_replace(label_replace(sum by (mcp_server_name, mcp_tool_name) (max_over_time(claude_code_token_usage_tokens_total{user_email=~\"$account\", mcp_tool_name!=\"\", mcp_tool_name!=\"custom\"}[$__range])), \"server\", \"$1\", \"mcp_server_name\", \"(.*)\"), \"tool\", \"$1\", \"mcp_tool_name\", \"(.*)\"))"
