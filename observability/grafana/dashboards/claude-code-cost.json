  "timezone": "browser",
  "title": "Claude Code — Uso & Custo",
  "uid": "claude-code-cost",
  "schemaVersion": 39,
  "version": 19,
  "refresh": "30s",
  "description": "Foco em tokens e tempo. Custo (USD) fica na seção CUSTO, sempre por conta. Counters são séries por sessão que ficam stale ~5min após a sessão terminar; totais usam max_over_time.",
  "templating": {
    "list": [
      {
        "name": "account",
        "label": "Conta",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(claude_code_token_usage_tokens_total, user_email)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "model",
        "label": "Modelo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(claude_code_token_usage_tokens_total, model)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "mtd_hours",
        "label": "Horas desde início do mês",
        "description": "Janela month-to-date em horas — reseta no dia 1.",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result((day_of_month() - 1) * 24 + hour() + 1)",
          "refId": "A"
        },
        "regex": "/\\}\\s([0-9]+)/",
        "refresh": 2,
        "current": {
          "text": "744",
          "value": "744"
        }
      },
      {
        "name": "limit_tokens_5h",
        "type": "textbox",
        "label": "limit_tokens_5h",
        "query": "50000000",
        "current": {
          "text": "50000000",
          "value": "50000000"
        }
      },
      {
        "name": "limit_tokens_7d",
        "type": "textbox",
        "label": "limit_tokens_7d",
        "query": "300000000",
        "current": {
          "text": "300000000",
          "value": "300000000"
        }
      },
      {
        "name": "limit_cost_5h",
        "type": "textbox",
        "label": "limit_cost_5h",
        "query": "25",
        "current": {
          "text": "25",
          "value": "25"
        }
      },
      {
        "name": "limit_cost_7d",
