    {
      "type": "gauge",
      "title": "Tokens (5h) — % do limite",
      "description": "Janela rolante de 5h — aproxima a janela de sessao (Pro/Max) do Claude Code. Contador de tokens, nao o limite oficial da Anthropic (que e por mensagens/uso, nao exposto via OTel). Percentual estimado sobre o limite configurado na variavel $limit_tokens_5h (ajuste em Dashboard settings > Variables para o valor real do teu plano; a Anthropic nao expõe o limite exato via OTel, isso e uma aproximacao).",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "clamp_max((sum by (user_email) (max_over_time(claude_code_token_usage_tokens_total{user_email=~\"$account\"}[5h]))) / $limit_tokens_5h * 100, 100)",
          "legendFormat": "{{user_email}}"
        }
