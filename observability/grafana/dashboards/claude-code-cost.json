                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Chamadas",
            "desc": true
          },
          {
            "displayName": "Tokens",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "server": "Servidor",
              "tool": "Ferramenta",
              "Value": "Tokens",
              "Value #A": "Tokens",
              "Value #B": "Chamadas"
            },
            "indexByName": {
              "server": 0,
              "tool": 1,
              "Value": 2,
              "Value #A": 2,
              "Value #B": 3
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table",
          "expr": "sum by (server, tool) (label_replace(label_replace(sum by (mcp_server_name, mcp_tool_name) (max_over_time(claude_code_token_usage_tokens_total{user_email=~\"$account\", mcp_tool_name!=\"\", mcp_tool_name!=\"custom\"}[$__range])), \"server\", \"$1\", \"mcp_server_name\", \"(.*)\"), \"tool\", \"$1\", \"mcp_tool_name\", \"(.*)\"))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum by (server, tool) (count_over_time({service_name=\"claude-code\"} | tool_name=~\"mcp__.+\" | line_format \"{{.tool_name}}\" | regexp \"mcp__(?P<server>.+?)__(?P<tool>.+)\" [$__range]))"
        }
      ],
      "description": "Quais ferramentas concentram uso? Tokens = Prometheus, apenas servidores não redigidos; Chamadas = eventos MCP no Loki, incluindo servidores locais. São métricas distintas: — significa indisponível, não zero. Ordenação inicial por chamadas, depois tokens; clique em Tokens para priorizar consumo. Conta filtra apenas tokens; Modelo não se aplica a este painel. Chamadas consideram todos os logs MCP no período."
    },
