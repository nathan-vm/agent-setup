{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "title": "Claude Code — Uso & Custo",
  "uid": "claude-code-cost",
  "schemaVersion": 39,
  "version": 17,
  "refresh": "30s",
  "description": "Foco em tokens e tempo. Custo (USD) fica na seção CUSTO, sempre por conta. Counters são séries por sessão que ficam stale ~5min após a sessão terminar; totais usam max_over_time.",
  "templating": {
    "list": [
      { "name": "account", "label": "Conta", "type": "query", "datasource": { "type": "prometheus", "uid": "prometheus" }, "query": { "query": "label_values(claude_code_token_usage_tokens_total, user_email)", "refId": "A" }, "includeAll": true, "multi": true, "current": { "text": "All", "value": "$__all" } },
      { "name": "model", "label": "Modelo", "type": "query", "datasource": { "type": "prometheus", "uid": "prometheus" }, "query": { "query": "label_values(claude_code_token_usage_tokens_total, model)", "refId": "A" }, "includeAll": true, "multi": true, "current": { "text": "All", "value": "$__all" } },
      { "name": "mtd_hours", "label": "Horas desde início do mês", "description": "Janela month-to-date em horas — reseta no dia 1.", "type": "query", "hide": 2, "datasource": { "type": "prometheus", "uid": "prometheus" }, "query": { "query": "query_result((day_of_month() - 1) * 24 + hour() + 1)", "refId": "A" }, "regex": "/\\}\\s([0-9]+)/", "refresh": 2, "current": { "text": "744", "value": "744" } }
    ]
  },
  "panels": [
    { "type": "row", "title": "USO", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },

    {
      "type": "stat", "title": "Tokens (total) por conta",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "noValue": "0" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "none" },
      "targets": [ { "refId": "A", "instant": true, "expr": "sum by (user_email) (max_over_time(claude_code_token_usage_tokens_total{user_email=~\"$account\"}[90d]))", "legendFormat": "{{user_email}}" } ]
    },
    {
      "type": "stat", "title": "Tokens (24h) por conta",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "noValue": "0" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "none" },
      "targets": [ { "refId": "A", "instant": true, "expr": "sum by (user_email) (max_over_time(claude_code_token_usage_tokens_total{user_email=~\"$account\"}[24h]))", "legendFormat": "{{user_email}}" } ]
    },
    {
      "type": "stat", "title": "Tempo ativo por conta",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "noValue": "0" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "none" },
      "targets": [ { "refId": "A", "instant": true, "expr": "sum by (user_email) (max_over_time(claude_code_active_time_seconds_total{user_email=~\"$account\"}[$__range]))", "legendFormat": "{{user_email}}" } ]
    },
    {
      "type": "stat", "title": "Tokens por minuto ativo",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "0" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "none" },
      "targets": [ { "refId": "A", "instant": true, "expr": "sum by (user_email) (max_over_time(claude_code_token_usage_tokens_total{user_email=~\"$account\"}[$__range])) / clamp_min(sum by (user_email) (max_over_time(claude_code_active_time_seconds_total{user_email=~\"$account\"}[$__range])) / 60, 1)", "legendFormat": "{{user_email}}" } ]
    },

    {
      "type": "stat", "title": "Cache hit ratio",
      "description": "cacheRead / (cacheRead + cacheCreation + input). Alto = contexto reaproveitado, menos custo.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "min": 0, "max": 1, "noValue": "—", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 0.8 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "orientation": "auto", "textMode": "value", "colorMode": "background", "graphMode": "none" },
      "targets": [ { "refId": "A", "instant": true, "expr": "sum(max_over_time(claude_code_token_usage_tokens_total{type=\"cacheRead\", user_email=~\"$account\"}[$__range])) / clamp_min(sum(max_over_time(claude_code_token_usage_tokens_total{type=~\"cacheRead|cacheCreation|input\", user_email=~\"$account\"}[$__range])), 1)" } ]
    },
    {
      "type": "piechart", "title": "Mix de tipo de token",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } },
      "targets": [ { "refId": "A", "instant": true, "expr": "sum by (type) (max_over_time(claude_code_token_usage_tokens_total{user_email=~\"$account\"}[$__range]))", "legendFormat": "{{type}}" } ]
    },
    {
      "type": "timeseries", "title": "Throughput (tokens / hora)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (user_email) (rate(claude_code_token_usage_tokens_total{user_email=~\"$account\"}[$__rate_interval])) * 3600", "legendFormat": "{{user_email}}" } ]
    },

    {
      "type": "timeseries", "title": "Tokens por tipo (/ bucket)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (type) (increase(claude_code_token_usage_tokens_total{user_email=~\"$account\"}[$__rate_interval]))", "legendFormat": "{{type}}" } ]
    },
    {
      "type": "timeseries", "title": "Tokens por modelo (/ bucket)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (model) (increase(claude_code_token_usage_tokens_total{user_email=~\"$account\", model=~\"$model\"}[$__rate_interval]))", "legendFormat": "{{model}}" } ]
    },

    {
      "type": "timeseries", "title": "Tokens por query_source (/ bucket)",
      "description": "main = sessão principal · subagent = subagentes · auxiliary = chamadas internas (título, etc).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (query_source) (increase(claude_code_token_usage_tokens_total{user_email=~\"$account\"}[$__rate_interval]))", "legendFormat": "{{query_source}}" } ]
    },
    {
      "type": "timeseries", "title": "Tokens por skill (/ bucket)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (skill_name) (increase(claude_code_token_usage_tokens_total{user_email=~\"$account\", skill_name!=\"\"}[$__rate_interval]))", "legendFormat": "{{skill_name}}" } ]
    },

    {
      "type": "piechart", "title": "Tokens por skill",
      "description": "Tokens gastos dentro de skills. Tokens sem skill associada são omitidos.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }, "tooltip": { "mode": "single" } },
      "targets": [ { "refId": "A", "instant": true, "expr": "sum by (skill_name) (max_over_time(claude_code_token_usage_tokens_total{user_email=~\"$account\", skill_name!=\"\"}[$__range]))", "legendFormat": "{{skill_name}}" } ]
    },
    {
      "type": "table", "title": "Tokens por MCP tool",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [ { "matcher": { "id": "byName", "options": "Tokens" }, "properties": [ { "id": "unit", "value": "short" }, { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } } ] } ] },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Tokens", "desc": true } ] },
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "mcp_server_name": "Servidor", "mcp_tool_name": "Tool", "Value": "Tokens" }, "indexByName": { "mcp_server_name": 0, "mcp_tool_name": 1, "Value": 2 } } } ],
      "targets": [ { "refId": "A", "instant": true, "format": "table", "expr": "sum by (mcp_server_name, mcp_tool_name) (max_over_time(claude_code_token_usage_tokens_total{user_email=~\"$account\", mcp_tool_name!=\"\"}[$__range]))" } ]
    },

    {
      "type": "stat", "title": "Linhas de código (total) por conta",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "noValue": "0" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "none" },
      "targets": [ { "refId": "A", "instant": true, "expr": "sum by (user_email, type) (max_over_time(claude_code_lines_of_code_count_total{user_email=~\"$account\"}[90d]))", "legendFormat": "{{user_email}} {{type}}" } ]
    },
    {
      "type": "timeseries", "title": "Linhas de código modificadas (/ bucket)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "noValue": "0" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (type) (increase(claude_code_lines_of_code_count_total{user_email=~\"$account\"}[$__rate_interval]))", "legendFormat": "{{type}}" } ]
    },

    { "type": "row", "title": "CUSTO", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 47 } },
    {
      "type": "stat", "title": "Custo do mês corrente (USD) por conta",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "noValue": "0" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value" },
      "targets": [ { "refId": "A", "instant": true, "expr": "sum by (user_email) (max_over_time(claude_code_cost_usage_USD_total{user_email=~\"$account\", model=~\"$model\"}[${mtd_hours}h]))", "legendFormat": "{{user_email}}" } ]
    },
    {
      "type": "stat", "title": "Custo (24h, USD) por conta",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "noValue": "0" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value" },
      "targets": [ { "refId": "A", "instant": true, "expr": "sum by (user_email) (max_over_time(claude_code_cost_usage_USD_total{user_email=~\"$account\", model=~\"$model\"}[24h]))", "legendFormat": "{{user_email}}" } ]
    },
    {
      "type": "timeseries", "title": "Custo por conta (USD / bucket)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "fillOpacity": 15, "stacking": { "mode": "none" } } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (user_email) (increase(claude_code_cost_usage_USD_total{user_email=~\"$account\", model=~\"$model\"}[$__rate_interval]))", "legendFormat": "{{user_email}}" } ]
    },
    {
      "type": "timeseries", "title": "Custo por modelo — $account (USD / bucket)",
      "repeat": "account", "repeatDirection": "h", "maxPerRow": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (model) (increase(claude_code_cost_usage_USD_total{user_email=~\"$account\", model=~\"$model\"}[$__rate_interval]))", "legendFormat": "{{model}}" } ]
    },
    {
      "type": "timeseries", "title": "Custo acumulado por sessão (USD)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 60 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "fillOpacity": 10, "showPoints": "never", "lineInterpolation": "stepAfter" } }, "overrides": [] },
      "options": { "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "sum by (user_email, session_id) (claude_code_cost_usage_USD_total{user_email=~\"$account\", model=~\"$model\"})", "legendFormat": "{{user_email}} / {{session_id}}" } ]
    },
    {
      "type": "table", "title": "Custo por conta e modelo (90d)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 69 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Custo (USD)", "desc": true } ] },
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "user_email": "Conta", "model": "Modelo", "Value": "Custo (USD)" }, "indexByName": { "user_email": 0, "model": 1, "Value": 2 } } } ],
      "targets": [ { "refId": "A", "instant": true, "format": "table", "expr": "sum by (user_email, model) (max_over_time(claude_code_cost_usage_USD_total{user_email=~\"$account\", model=~\"$model\"}[90d]))" } ]
    },
    {
      "type": "table", "title": "Por sessão — tokens, tempo e custo",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 69 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [
        { "matcher": { "id": "byName", "options": "Sessão" }, "properties": [ { "id": "mappings", "value": [] } ] },
        { "matcher": { "id": "byName", "options": "Tokens" }, "properties": [ { "id": "unit", "value": "short" } ] },
        { "matcher": { "id": "byName", "options": "Tempo ativo" }, "properties": [ { "id": "unit", "value": "s" } ] },
        { "matcher": { "id": "byName", "options": "Custo (USD)" }, "properties": [ { "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 4 }, { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } } ] }
      ] },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Tokens", "desc": true } ] },
      "targets": [
        { "refId": "A", "instant": true, "format": "table", "expr": "sum by (session_id, user_email) (max_over_time(claude_code_token_usage_tokens_total{user_email=~\"$account\"}[$__range]))" },
        { "refId": "B", "instant": true, "format": "table", "expr": "sum by (session_id, user_email) (max_over_time(claude_code_active_time_seconds_total{user_email=~\"$account\"}[$__range]))" },
        { "refId": "C", "instant": true, "format": "table", "expr": "sum by (session_id, user_email) (max_over_time(claude_code_cost_usage_USD_total{user_email=~\"$account\", model=~\"$model\"}[$__range]))" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "session_id": "Sessão", "user_email": "Conta", "Value #A": "Tokens", "Value #B": "Tempo ativo", "Value #C": "Custo (USD)" }, "indexByName": { "session_id": 0, "user_email": 1, "Value #A": 2, "Value #B": 3, "Value #C": 4 } } }
      ]
    }
  ]
}
