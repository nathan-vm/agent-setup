          "titleSize": 12,
          "valueSize": 32
        }
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum by (user_email) (max_over_time(claude_code_active_time_seconds_total{user_email=~\"$account\"}[$__range]))",
          "legendFormat": "{{user_email}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Tokens/min ativo",
      "description": "Tokens acumulados / minutos ativos das sessões observadas no período. Inclui entrada, saída e cache; não mede velocidade de geração da resposta.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "none",
        "wideLayout": false,
        "text": {
          "titleSize": 12,
          "valueSize": 32
        }
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum by (user_email) (max_over_time(claude_code_token_usage_tokens_total{user_email=~\"$account\"}[$__range])) / clamp_min(sum by (user_email) (max_over_time(claude_code_active_time_seconds_total{user_email=~\"$account\"}[$__range])) / 60, 1)",
          "legendFormat": "{{user_email}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Cache reutilizado",
      "description": "cacheRead / (cacheRead + cacheCreation + input), no período selecionado. Mostra quanto do contexto é reaproveitado. Sem meta universal; depende do tipo de tarefa.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "text": {
          "valueSize": 32
        }
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(max_over_time(claude_code_token_usage_tokens_total{type=\"cacheRead\", user_email=~\"$account\"}[$__range])) / clamp_min(sum(max_over_time(claude_code_token_usage_tokens_total{type=~\"cacheRead|cacheCreation|input\", user_email=~\"$account\"}[$__range])), 1)"
        }
      ]
    },
