  "timezone": "browser",
  "title": "Claude Code — Uso & Custo",
  "uid": "claude-code-cost",
  "schemaVersion": 39,
  "version": 23,
  "refresh": "30s",
  "description": "Resumo → skills e MCP → ritmo e composição → investigação → limites estimados → custo e detalhes. Totais usam o máximo dos contadores por sessão observados na janela, não necessariamente apenas o consumo ocorrido nela. Limites são referências configuráveis, não cotas oficiais da Anthropic.",
  "templating": {
    "list": [
      {
        "name": "account",
        "label": "Conta",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(claude_code_token_usage_tokens_total, user_email)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "model",
        "label": "Modelo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(claude_code_token_usage_tokens_total, model)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "mtd_hours",
        "label": "Horas desde início do mês",
        "description": "Janela month-to-date em horas — reseta no dia 1.",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result((day_of_month() - 1) * 24 + hour() + 1)",
          "refId": "A"
        },
        "regex": "/\\}\\s([0-9]+)/",
        "refresh": 2,
        "current": {
          "text": "744",
          "value": "744"
        }
      },
      {
        "name": "limit_tokens_5h",
        "type": "textbox",
        "label": "Referência de tokens (5h)",
        "hide": 2,
        "query": "50000000",
        "current": {
          "text": "50000000",
          "value": "50000000"
        }
      },
      {
        "name": "limit_tokens_7d",
        "type": "textbox",
        "label": "Referência de tokens (7d)",
        "hide": 2,
        "query": "300000000",
        "current": {
          "text": "300000000",
          "value": "300000000"
        }
      },
      {
        "name": "limit_cost_5h",
        "type": "textbox",
        "label": "Referência de custo (5h, USD)",
        "hide": 2,
        "query": "25",
        "current": {
          "text": "25",
          "value": "25"
        }
      },
      {
        "name": "limit_cost_7d",
        "type": "textbox",
        "label": "Referência de custo (7d, USD)",
        "hide": 2,
        "query": "140",
        "current": {
          "text": "140",
          "value": "140"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "VISÃO GERAL",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Tokens (24h)",
      "description": "Soma do maior contador de cada sessão observada nas últimas 24h. Janela fixa; sessões iniciadas antes dela podem incluir consumo anterior.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "none",
        "wideLayout": false,
        "text": {
          "titleSize": 12,
          "valueSize": 32
        }
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum by (user_email) (max_over_time(claude_code_token_usage_tokens_total{user_email=~\"$account\"}[24h]))",
          "legendFormat": "{{user_email}}"
        }
      ]
    },
